# ---------------------------------------------------------------------
# Public site configuration (safe to expose to the browser)
# ---------------------------------------------------------------------
NEXT_PUBLIC_MAIN_SITE_URL=https://www.dravonixmedia.com
NEXT_PUBLIC_ESTIMATOR_URL=https://estimate.dravonix.dev
# Leave empty for the estimator to run at the domain root. Set this only
# if you later mount it at a sub-path such as /pricing/estimate.
NEXT_PUBLIC_ESTIMATOR_BASE_PATH=
NEXT_PUBLIC_CONTACT_EMAIL=admin@dravonixmedia.com
NEXT_PUBLIC_CONTACT_PAGE_URL=https://www.dravonixmedia.com/contact
NEXT_PUBLIC_PRIVACY_URL=https://estimate.dravonix.dev/privacy
NEXT_PUBLIC_TERMS_URL=https://estimate.dravonix.dev/terms
NEXT_PUBLIC_PRICING_URL=https://www.dravonixmedia.com/pricing
# WhatsApp number in E.164 digits only, no + or spaces, e.g. 919000000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Set to "false" to block search engine indexing (use on staging deployments).
NEXT_PUBLIC_ALLOW_INDEXING=true

# ---------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------
# Project URL and anon key are inlined into the browser bundle at build
# time via next.config.ts — the anon key is safe to expose (RLS enforces
# access control). Never put the service-role key in these two.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key — server-only, never exposed to the browser. Used by
# API routes to save leads, generate estimates, and read pricing data.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Claude API (Anthropic) — used only to interpret project descriptions.
# The estimator works without this configured (silent fallback to manual
# service selection).
# ---------------------------------------------------------------------
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
